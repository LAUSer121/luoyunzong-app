# ===== 落云宗服务端配置（复制为 .env 并填自己的值）=====
# 说明：.env 已在 .gitignore 中忽略，不会提交到仓库。

# ---- HTTP 服务 ----
PORT=8080
# 客户端「设置 → 数据源 → 访问令牌」要填同一个值；留空则不校验（仅本机调试用）
API_TOKEN=change-me-please
# 多宗门时用不同 ORG_ID 区分
ORG_ID=default

# ---- Aiven MySQL（免费版）----
# 注意：Aiven 要求 SSL，保持 DB_SSL=true
DB_HOST=mysql-xxxxx-xxxx.g.aivencloud.com
DB_PORT=23483
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_SSL=true

# ---- 资源存储：local | upyun | s3 ----
# 说明：管理员在 App「设置 → 云端资源存储」里保存过之后，以数据库里的配置为准，
#       这里的 .env 值只是「App 里还没配过」时的出厂默认。
# local：存在服务器磁盘 uploads/ 目录（最简单，先跑通用这个）
# s3：缤纷云 S4 / Cloudflare R2 / AWS S3 / MinIO 等兼容 S3 的服务（推荐）
# upyun：又拍云对象存储
STORAGE_DRIVER=local

# ---- 缤纷云 S4（STORAGE_DRIVER=s3 时填这组）----
# 控制台 → 对象存储「Bucket 设置」页底部能看到 Endpoint
S3_ENDPOINT=https://s3.bitiful.net
S3_REGION=cn-east-1
S3_BUCKET=my-media
# 子账户 Key（控制台 →「子账户&Key」）；记得给该子用户**授予这个桶的读写权限**，
# 否则上传会报 403 AccessDenied。
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 公开访问域名（可选）：填了就把资源直链指到它；留空则由服务端 /assets/<id> 中转
# （私有桶 + 没绑自定义域名时建议留空）。
S3_PUBLIC_BASE=

# ---- 又拍云（STORAGE_DRIVER=upyun 时必填）----
# 服务名 = 你在又拍云建的「存储桶/服务名」
UPYUN_BUCKET=my-media
# 操作员名（又拍云「操作员」或子用户名）与其密码
UPYUN_OPERATOR=mymedia
UPYUN_PASSWORD=your-operator-password
# 访问域名（用于拼最终 URL）：绑定的 CDN 域名或默认测试域名
UPYUN_DOMAIN=https://my-media.test.upcdn.net
# 可选：子账户 Access Key / Secret Key（用于部分管理类接口）
UPYUN_ACCESS_KEY=
UPYUN_SECRET_KEY=

# ---- 其它 S3 兼容服务（R2 / MinIO / AWS）----
# R2 示例：S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com / S3_REGION=auto
